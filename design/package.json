{
    "name": "worldlens",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "bootstrap": "node ../scripts/bootstrap.mjs",
        "bootstrap:check": "node ../scripts/bootstrap.mjs --check",
        "build": "pnpm -r --fail-if-no-match --filter \"./packages/**\" run build",
        "typecheck": "pnpm -r --fail-if-no-match --filter \"./packages/**\" run typecheck",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ci": "node ../scripts/run-tests-ci.mjs",
        "screenshots:check": "node --test ../scripts/check-screenshot-evidence.test.mjs && node ../scripts/check-screenshot-evidence.mjs",
        "workflows:check": "node --test ../scripts/lint-workflows.test.mjs && node ../scripts/lint-workflows.mjs ..",
        "ui:e2e:lowlevel": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/run-worldlens-lowlevel-e2e.ps1",
        "ui:e2e:lowlevel:check": "node --test ../scripts/worldlens-lowlevel-e2e.test.mjs",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "@vitejs/plugin-vue": "^5.2.4",
        "eslint": "^9.30.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.6.0",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.35.0",
        "vitest": "^3.2.0",
        "vue": "^3.5.40"
    }
}

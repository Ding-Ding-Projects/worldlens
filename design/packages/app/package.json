{
    "name": "@worldlens/app",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Worldlens desktop application for rendering and publishing Minecraft world maps",
    "author": "Worldlens contributors",
    "main": "./dist/main/index.js",
    "scripts": {
        "brand:build": "node scripts/build-brand-assets.mjs",
        "stage:render-engines": "node scripts/stage-render-engines.mjs",
        "build:hosted": "node build.mjs --hosted-only",
        "build": "node scripts/build-brand-assets.mjs --check && node build.mjs",
        "start": "electron .",
        "test": "vitest run",
        "package": "node scripts/build-brand-assets.mjs --check && node build.mjs && node scripts/stage-bundled-runtimes.mjs && electron-builder --dir --config electron-builder.config.cjs",
        "make": "node scripts/build-brand-assets.mjs --check && node build.mjs && node scripts/stage-bundled-runtimes.mjs && electron-builder --win --config electron-builder.config.cjs --publish never",
        "screenshots": "playwright test --config playwright.config.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "prestart": "node ../../scripts/ensure-electron-binary.mjs",
        "prescreenshots": "node ../../scripts/ensure-electron-binary.mjs"
    },
    "devDependencies": {
        "electron": "^37.10.3",
        "electron-builder": "^26.0.0",
        "esbuild": "^0.25.12",
        "@playwright/test": "^1.50.0",
        "@bokuweb/zstd-wasm": "^0.0.27",
        "rcedit": "5.0.2",
        "sharp": "0.35.3"
    },
    "dependencies": {
        "@worldlens/bridge": "workspace:*",
        "@worldlens/dockhand": "workspace:*",
        "@worldlens/config": "workspace:*",
        "@worldlens/engine": "workspace:*",
        "@worldlens/nbt": "workspace:*",
        "@worldlens/parts": "workspace:*",
        "@worldlens/render-actions": "workspace:*",
        "@worldlens/server": "workspace:*",
        "@worldlens/shared": "workspace:*",
        "@worldlens/worldgen": "workspace:*",
        "electron-store": "^10.1.0",
        "yaml": "^2.6.1"
    }
}

{
    "name": "@worldlens/md3-check",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "An honest, plain Electron harness that renders canonical Material Design 3 reference markup beside this repository's own Worldlens (Vuetify) components, measures both, and captures the comparison. Not a product; an instrument. See README.md for exactly what it can and cannot prove.",
    "main": "./src/main/index.mjs",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "start": "electron .",
        "capture": "vite build && node scripts/capture.mjs",
        "typecheck": "vue-tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "prestart": "node ../../scripts/ensure-electron-binary.mjs",
        "precapture": "node ../../scripts/ensure-electron-binary.mjs"
    },
    "dependencies": {
        "@fontsource/roboto": "^5.3.0",
        "@mdi/js": "^7.4.47",
        "@worldlens/ui": "workspace:*",
        "vue": "^3.5.40"
    },
    "devDependencies": {
        "@playwright/test": "^1.50.0",
        "@vitejs/plugin-vue": "^5.2.4",
        "electron": "^37.10.3",
        "sass-embedded": "^1.100.0",
        "vite": "^6.4.3",
        "vue-tsc": "^2.2.12"
    }
}

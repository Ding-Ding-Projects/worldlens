{
    "name": "@worldlens/shared",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Wire formats, config schema, math, and shared utilities ported from BlueMap",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@worldlens/design-system": "workspace:*"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./vocabulary": {
            "types": "./dist/vocabulary.d.ts",
            "import": "./dist/vocabulary.js"
        },
        "./virtualDisk": {
            "types": "./dist/virtualDisk.d.ts",
            "import": "./dist/virtualDisk.js"
        },
        "./base64": {
            "types": "./dist/base64.d.ts",
            "import": "./dist/base64.js"
        },
        "./dist/*": "./dist/*"
    }
}

{
    "name": "@worldlens/kid-check",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "A plain Electron harness that boots @worldlens/ui with Kid Mode forced on, so every kid surface can be driven and photographed against the real renderer rather than a stubbed one.",
    "main": "./dist/main/index.js",
    "scripts": {
        "build": "node build.mjs",
        "start": "electron .",
        "capture": "playwright test --config playwright.config.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "prestart": "node ../../scripts/ensure-electron-binary.mjs",
        "precapture": "node ../../scripts/ensure-electron-binary.mjs"
    },
    "dependencies": {
        "@worldlens/server": "workspace:*"
    },
    "devDependencies": {
        "electron": "^37.10.3",
        "esbuild": "^0.25.12",
        "@playwright/test": "^1.50.0"
    }
}

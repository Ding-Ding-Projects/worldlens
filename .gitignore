# Java toolchain and build state for the vendored upstream renderer.
# Provisioned into the repository so no machine-wide toolchain is touched, and
# ignored because it is over a gigabyte of downloaded Gradle and dependencies.
tools/oracle/.gradle/
tools/oracle/jdk/
tools/oracle/out/

# Resolved JDBC driver jars (tools/oracle/driver-fetch) - reproducible from
# build.gradle.kts against Maven Central, never worth committing a binary jar for.
tools/oracle/driver-fetch/build/
tools/oracle/driver-fetch/.gradle/

# Built artefacts of the vendored upstream source.
vendor/BlueMap/**/build/
vendor/BlueMap/.gradle/

# Generated test worlds.
test-world/
*.mca

# BlueMap render output. The CLI resolves its storage root and its data folder
# relative to the working directory, not the config folder, so running it from
# the repository root drops tens of megabytes of tiles and a downloaded Mojang
# client jar straight into the tree. Never commit either.
/web/
/data/

# Compiled classes and dumps of the unit-level PRBM reference capture.
tools/oracle/prbm/out/

# Extracted design reference for the Material Design 3 shell rewrite. The prototype runtime,
# its screenshots and its 6 MB of PNGs are inspected, never shipped.
.codex/

# Locally built installers. uild-installer.bat writes here so the artifact is always in
# one predictable place next to the checkout - and never committed: a 157 MB setup in Git
# history is a repository nobody can clone.
/installer/
/artifacts/

# The version build-installer.bat stamps aside while it packages, so it can put the real one
# back afterwards. It is deleted by that restore step; a copy surviving means a run was
# interrupted, and it must never be committed - a stray file naming a version nobody chose
# reads to the next person as a deliberate release decision.
design/packages/app/.version-backup

# Screenshots taken by .claude/skills/run-worldlens/driver.mjs
.worldlens-driver/

# Linked worktrees created for parallel work. They are checkouts of this same
# repository, so tracking them would commit one lane into another.
wl-lanes/

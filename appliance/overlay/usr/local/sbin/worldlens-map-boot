#!/bin/sh
# Worldlens map appliance: runs at boot.
#
# 1. Find the data partition: a block device whose first 512-byte sector is a POSIX tar header
#    (ustar magic) whose first member is worldlens-map.json.
# 2. Extract it to /var/lib/worldlens/data.
# 3. Load the bundled map-server image and run it with --restart always.
# 4. Print the address large on tty1 and announce <hostname>.local over mDNS.
#
# Contract with the map-server image (worldlens-map-server:bundled):
#   - it reads /data/worldlens-map.json (hostname, port, accessCodeVerifier, labels)
#   - it serves the map from /data/map
#   - it listens on HTTP port 8080 inside the container and answers GET /health with 200
set -u

STATE=/var/lib/worldlens
DATA=$STATE/data
IMAGE=worldlens-map-server:bundled
INTERNAL_PORT=8080
TTY=/dev/tty1

say() { printf '%s\n' "$*" >> /var/log/worldlens-map.log; printf 'worldlens: %s\n' "$*" > /dev/console 2>/dev/null || true; }

banner() {
    # $1 title  $2 line  $3 optional address
    {
        printf '\033[2J\033[H\n\n'
        printf '    \033[1m%s\033[0m\n\n' "$1"
        printf '    %s\n\n' "$2"
        [ -n "${3:-}" ] && printf '    \033[1;7m  %s  \033[0m\n\n' "$3"
    } > "$TTY" 2>/dev/null || true
    {
        printf '\n%s\n%s\n' "$1" "$2"
        [ -n "${3:-}" ] && printf '%s\n' "$3"
    } > /etc/issue
}

find_data() {
    for dev in /dev/sd?[0-9]* /dev/vd?[0-9]* /dev/nvme?n?p[0-9]* /dev/mmcblk?p[0-9]*; do
        [ -b "$dev" ] || continue
        magic=$(dd if="$dev" bs=1 skip=257 count=5 2>/dev/null)
        name=$(dd if="$dev" bs=1 count=18 2>/dev/null)
        if [ "$magic" = "ustar" ] && [ "$name" = "worldlens-map.json" ]; then
            echo "$dev"
            return 0
        fi
    done
    return 1
}

mkdir -p "$STATE"
TITLE="Worldlens map"
banner "$TITLE" "Starting the map server"

# USB and slow controllers can take a while to show their partitions.
DEV=
for _ in $(seq 1 60); do
    DEV=$(find_data) && break
    sleep 1
done
if [ -z "$DEV" ]; then
    banner "$TITLE" "No map data was found. Rebuild the appliance from Worldlens, or attach its data disk."
    say "no data partition found"
    exit 1
fi
say "data partition: $DEV"

STAMP="$(dd if="$DEV" bs=512 count=1 2>/dev/null | sha256sum | cut -d' ' -f1)-$(blockdev --getsize64 "$DEV")"
if [ "$(cat "$STATE/data.stamp" 2>/dev/null)" != "$STAMP" ]; then
    rm -rf "$DATA"
    mkdir -p "$DATA"
    tar -x -f "$DEV" -C "$DATA" || { say "tar extract failed"; banner "$TITLE" "The map data could not be read."; exit 1; }
    echo "$STAMP" > "$STATE/data.stamp"
fi

CONFIG=$DATA/worldlens-map.json
HOST=$(jq -r '.hostname // "worldlens-map"' "$CONFIG")
PORT=$(jq -r '.port // 80' "$CONFIG")
TITLE=$(jq -r '.labels.consoleTitle // "Worldlens map"' "$CONFIG")
READY=$(jq -r '.labels.consoleReady // "The map is running. Open this address from any computer on the network:"' "$CONFIG")
STARTING=$(jq -r '.labels.consoleStarting // "Starting the map server"' "$CONFIG")
banner "$TITLE" "$STARTING"

hostname "$HOST"
echo "$HOST" > /etc/hostname
sed -i "s/^#\?host-name=.*/host-name=$HOST/" /etc/avahi/avahi-daemon.conf 2>/dev/null
rc-service avahi-daemon restart >/dev/null 2>&1 || true

KIND=$(jq -r '.workload.kind // "map"' "$CONFIG")
# The console titles in the config describe a map; the other workloads say what they really run.
if [ "$KIND" = app ]; then
    TITLE="WorldLens"
    READY="WorldLens is running. Open this address from any computer on the network:"
elif [ "$KIND" = minecraft ]; then
    TITLE="Minecraft server"
    READY="The server is running. Players join this computer's address on port 25565; the management site is here:"
fi
HEALTH_PATH=health

# Container images need more room than the root file system has. The builder adds an empty
# partition for the app and server workloads; format it on first start (only if it is entirely
# empty, so nothing is ever overwritten) and keep Docker's data there.
use_storage() {
    STORE=$(blkid -L worldlens-docker 2>/dev/null)
    if [ -z "$STORE" ]; then
        for SYS in /sys/class/block/*; do
            P=/dev/$(basename "$SYS")
            [ -f "$SYS/partition" ] || continue
            [ "$P" = "$DEV" ] && continue
            grep -q "^$P " /proc/mounts && continue
            [ "$(cat "$SYS/size")" -ge 4194304 ] || continue
            # An all-zero first MiB means no file system or partition data of any kind is there.
            [ "$(dd if="$P" bs=1M count=1 2>/dev/null | od -An -v -tx1 | tr -d ' 0\n' | wc -c)" = 0 ] || continue
            say "formatting $P for container storage"
            timeout 300 mkfs.ext4 -q -F -E nodiscard,lazy_itable_init=1,lazy_journal_init=1 -L worldlens-docker "$P" && STORE=$P && break
        done
    fi
    [ -n "$STORE" ] || { say "no storage partition; using the root file system"; return 0; }
    # /var/lib/docker can already be a mount point in the base; only skip when it is this store.
    grep -q "^$STORE /var/lib/docker " /proc/mounts && return 0
    say "storage $STORE ready; moving Docker onto it"
    # --nodeps: this script is itself a service that needs docker, so a plain stop would make
    # OpenRC stop this script too, which is exactly how the first QEMU runs hung here.
    timeout 60 rc-service --nodeps docker stop >/dev/null 2>&1
    mkdir -p /var/lib/docker
    mount "$STORE" /var/lib/docker || { say "could not mount $STORE"; rc-service --nodeps docker start >/dev/null 2>&1; return 0; }
    timeout 60 rc-service --nodeps docker start >/dev/null 2>&1
    TRIES=0
    until docker info >/dev/null 2>&1; do
        TRIES=$((TRIES + 1))
        [ "$TRIES" -gt 60 ] && { say "Docker did not come back on $STORE"; tail -n 5 /var/log/docker.log 2>/dev/null | while read -r L; do say "docker: $L"; done; return 1; }
        sleep 2
    done
    say "container storage on $STORE"
}

if [ "$KIND" = app ] || [ "$KIND" = minecraft ]; then use_storage; fi
if [ "$KIND" = app ]; then
    # The whole WorldLens application (the hosted image), pulled by digest. Both values were
    # validated by the builder; they are checked again here because this script runs as root.
    APP_IMAGE=$(jq -r '.workload.image // ""' "$CONFIG")
    APP_HASH=$(jq -r '.workload.passwordSha256 // ""' "$CONFIG")
    echo "$APP_IMAGE" | grep -Eq '^[a-z0-9][a-z0-9._/-]{0,200}/worldlens-hosted(:[A-Za-z0-9._-]{1,64})?@sha256:[a-f0-9]{64}$' || { banner "$TITLE" "The WorldLens app image in this appliance is not valid. Rebuild it from WorldLens."; exit 1; }
    echo "$APP_HASH" | grep -Eq '^[a-f0-9]{64}$' || { banner "$TITLE" "This appliance has no password set. Rebuild it from WorldLens."; exit 1; }
    until docker image inspect "$APP_IMAGE" >/dev/null 2>&1; do
        banner "$TITLE" "Downloading the WorldLens app. The first start needs an internet connection."
        docker pull "$APP_IMAGE" >> /var/log/worldlens-map.log 2>&1 || sleep 15
    done
    docker rm -f worldlens-app >/dev/null 2>&1
    docker run -d --name worldlens-app --restart always -p "$PORT:8110" \
        -e WORLDLENS_PASSWORD_SHA256="$APP_HASH" -e WORLDLENS_DATA=/data/state \
        -e WORLDLENS_MOUNTS="maps:/data/maps:ro:Maps" \
        -v "$DATA/map:/data/maps:ro" -v worldlens-app-state:/data/state \
        "$APP_IMAGE" >> /var/log/worldlens-map.log 2>&1 || { banner "$TITLE" "The WorldLens app did not start."; exit 1; }
    HEALTH_PATH=
elif [ "$KIND" = minecraft ]; then
    # A Minecraft server plus its management site (owner-first accounts). Images by digest,
    # checked again here because this script runs as root.
    MC_IMAGE=$(jq -r '.workload.serverImage // ""' "$CONFIG")
    SITE_IMAGE=$(jq -r '.workload.siteImage // ""' "$CONFIG")
    MC_EULA=$(jq -r '.workload.eulaAccepted // false' "$CONFIG")
    MC_MEM=$(jq -r '.workload.memoryGb // 2' "$CONFIG")
    echo "$MC_IMAGE" | grep -Eq '^[a-z0-9][a-z0-9._/-]{0,200}(:[A-Za-z0-9._-]{1,64})?@sha256:[a-f0-9]{64}$' || { banner "$TITLE" "The Minecraft server image in this appliance is not valid. Rebuild it from WorldLens."; exit 1; }
    echo "$SITE_IMAGE" | grep -Eq '^[a-z0-9][a-z0-9._/-]{0,200}/worldlens-server-site(:[A-Za-z0-9._-]{1,64})?@sha256:[a-f0-9]{64}$' || { banner "$TITLE" "The management site image in this appliance is not valid. Rebuild it from WorldLens."; exit 1; }
    [ "$MC_EULA" = true ] || { banner "$TITLE" "The Minecraft EULA was not accepted, so the server will not start. Rebuild it from WorldLens."; exit 1; }
    echo "$MC_MEM" | grep -Eq '^[0-9]{1,2}$' || MC_MEM=2
    for IMG in "$MC_IMAGE" "$SITE_IMAGE"; do
        until docker image inspect "$IMG" >/dev/null 2>&1; do
            banner "$TITLE" "Downloading the Minecraft server. The first start needs an internet connection."
            docker pull "$IMG" >> /var/log/worldlens-map.log 2>&1 || sleep 15
        done
    done
    docker rm -f worldlens-mc worldlens-site >/dev/null 2>&1
    docker run -d --name worldlens-mc --restart always -p 25565:25565 -p 19132:19132/udp \
        -e EULA=TRUE -e MEMORY="${MC_MEM}G" -v worldlens-mc-data:/data \
        "$MC_IMAGE" >> /var/log/worldlens-map.log 2>&1 || { banner "$TITLE" "The Minecraft server did not start."; exit 1; }
    docker run -d --name worldlens-site --restart always -p "$PORT:8443" \
        -v /var/run/docker.sock:/var/run/docker.sock -v worldlens-site-state:/data/state -v worldlens-mc-data:/data/server \
        -e WORLDLENS_SITE_HOST="$HOST.local" -e WORLDLENS_SITE_LAN_HTTP=1 -e WORLDLENS_SITE_ORIGIN="http://$HOST.local:$PORT" \
        -e WORLDLENS_MC_NAME="$HOST" \
        "$SITE_IMAGE" >> /var/log/worldlens-map.log 2>&1 || { banner "$TITLE" "The management site did not start."; exit 1; }
    HEALTH_PATH=
else
    if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
        say "loading the bundled map-server image"
        docker load -i "$STATE/mapserver.tar" >> /var/log/worldlens-map.log 2>&1 || { banner "$TITLE" "The bundled map server could not be loaded."; exit 1; }
    fi
    docker rm -f worldlens-map >/dev/null 2>&1
    docker run -d --name worldlens-map --restart always -p "$PORT:$INTERNAL_PORT" -v "$DATA:/data:ro" "$IMAGE" >> /var/log/worldlens-map.log 2>&1 || { banner "$TITLE" "The map server did not start."; exit 1; }
fi

url() {
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -n1)
    [ -z "$ip" ] && ip=$(ip -4 -o addr show scope global | sed -n 's/.* inet \([0-9.]*\)\/.*/\1/p' | head -n1)
    [ -n "$ip" ] || return 1
    if [ "$PORT" = 80 ]; then echo "http://$ip/"; else echo "http://$ip:$PORT/"; fi
}

# Show the address once the server answers; keep refreshing in case the network address changes.
while true; do
    U=$(url) || U=
    if [ -n "$U" ] && curl -fsS -m 3 -o /dev/null "${U}${HEALTH_PATH}"; then
        if [ "$PORT" = 80 ]; then LOCAL="http://$HOST.local/"; else LOCAL="http://$HOST.local:$PORT/"; fi
        banner "$TITLE" "$READY" "$U   or   $LOCAL"
        sleep 60
    else
        banner "$TITLE" "$STARTING"
        sleep 3
    fi
done
